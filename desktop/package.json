{
  "name": "nexus-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop shell for the NEXUS MT5 market dashboard",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:backend": "node build-backend.cjs",
    "dist:win": "npm run build:backend && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nexus.desktop",
    "productName": "NEXUS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/Release/lumo-edge.exe",
        "to": "backend/lumo-edge.exe"
      },
      {
        "from": "../web",
        "to": "web"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
