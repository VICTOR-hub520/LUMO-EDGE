{
  "name": "Lumo Edge C++",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "src/main.cpp",
        "web/index.html"
      ]
    },
    "vscode": {
      "settings": {
        "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
        "cmake.configureOnOpen": true
      },
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  },
  "postCreateCommand": "if [ ! -d \"$HOME/vcpkg/.git\" ]; then git clone https://github.com/microsoft/vcpkg.git \"$HOME/vcpkg\"; fi && \"$HOME/vcpkg/bootstrap-vcpkg.sh\" -disableMetrics && cmake -S . -B build -DCMAKE_TOOLCHAIN_FILE=\"$HOME/vcpkg/scripts/buildsystems/vcpkg.cmake\"",
  "portsAttributes": {
    "8080": {
      "label": "Application",
      "onAutoForward": "openBrowser"
    }
  },
  "forwardPorts": [
    8080
  ]
}